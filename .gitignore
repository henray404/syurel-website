# LEADING SLASHES ARE LOAD-BEARING. A pattern without one matches at any depth,
# so a bare `data/` also ignores src/data/ -- which silently kept the entire
# conversion pipeline out of git. Anchor everything to the repo root.

# Data is never committed: multi-GB archives, and several sources are
# redistribution-restricted (LaRS and MaSTr1325 licenses are unconfirmed).
/data/

# Review overlays are regenerable; the verdict CSVs are NOT -- they are manual
# work, so they are kept.
/review/*/
!/review/*_verdict.csv

# Training runs: checkpoints are large, and every run is reproducible from its
# own config.yaml -- the source config in configs/train/ IS committed.
/runs/

# Inference time series. Regenerable from a checkpoint plus the source video, and
# at a real deployment it grows without bound.
/out/

# Benchmark temp checkpoints. bench/*.json IS committed -- it is the evidence
# behind the numbers in docs/model_comparison.md.
/bench/.*.tmp.pt

# Generated report
docs/data_validation.md

.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
